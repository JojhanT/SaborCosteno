{
  "name": "sabor-costeno-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de pedidos, cocina y turnos para Sabor Costeño ¡ajá!",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node server/index.js --dev",
    "build": "vite build --config client/vite.config.ts",
    "start": "node server/index.js",
    "typecheck": "tsc -p client --noEmit",
    "test": "npm run test:unit",
    "test:unit": "node --test \"server/**/!(*.integration).test.js\"",
    "test:integration": "node --test server/flujo.integration.test.js",
    "reset-claves": "node server/scripts/reset-claves.js",
    "respaldo": "node server/scripts/respaldo.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "mysql2": "^3.15.4"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "5.9",
    "vite": "^8.3.1"
  }
}
