# Copia este archivo como .env y cambia el dominio.
# El dominio debe apuntar (registro A) a la IP del VPS antes de arrancar,
# así Caddy puede sacar el certificado HTTPS.
DOMINIO=pedidos.tudominio.com

# Base de datos MySQL (contenedor propio, no queda expuesto a internet).
# Cambia estas contraseñas antes de arrancar en producción.
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root
MYSQL_DATABASE=sabor
MYSQL_USER=sabor
MYSQL_PASSWORD=cambia-esta-clave
